{
  "name": "crucible",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3847",
    "dev:worker": "tsx worker/index.ts",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3847}",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:unit": "tsx scripts/unit-smoke.ts && tsx scripts/competition-unit.ts",
    "release:check": "tsx scripts/release-check.ts",
    "release:prepare": "prisma migrate deploy && tsx prisma/seed.ts && tsx scripts/release-check.ts",
    "setup:local": "prisma db push && tsx prisma/seed.ts && tsx scripts/release-check.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "test:smoke": "node scripts/platform-smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "nanoid": "^6.0.2",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "openai": "^7.47.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.17.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
