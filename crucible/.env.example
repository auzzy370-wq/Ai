# Copy to .env and replace every REPLACE_ME_* value before starting local services.
# On Vercel: use Neon/Vercel Postgres pooled URL with sslmode=require

POSTGRES_USER="crucible"
POSTGRES_PASSWORD="REPLACE_ME_POSTGRES_PASSWORD"
POSTGRES_DB="crucible"
DATABASE_URL="postgresql://crucible:REPLACE_ME_POSTGRES_PASSWORD@localhost:5432/crucible?schema=public"

# Local Redis with a password (compose requires REDIS_PASSWORD)
REDIS_PASSWORD="REPLACE_ME_REDIS_PASSWORD"
REDIS_URL="redis://:REPLACE_ME_REDIS_PASSWORD@localhost:6379"

# REQUIRED for OAuth / sessions — fail closed if missing (min 16 chars). Never commit real values.
SESSION_SECRET="REPLACE_ME_LONG_RANDOM_SESSION_SECRET"
SETUP_SECRET="REPLACE_ME_SETUP_BOOTSTRAP_SECRET"
APP_URL="http://localhost:3847"
NEXT_PUBLIC_APP_URL="http://localhost:3847"
# COOKIE_SECURE=true
# FORCE_HTTPS=true
# TRUST_X_FORWARDED_FOR=true
# REQUIRE_ORIGIN_HEADER=false
# BCRYPT_ROUNDS=10
STORAGE_ROOT="./storage"

# Only docker is supported. Host-process / scratch execution is refused.
EXECUTION_MODE="docker"
WORKER_CONCURRENCY="2"
# Live judging: require a worker process. Leave unset/false in public deploys without Docker.
# JUDGE_ONLINE=true

# Free AI vs Human (preferred) — https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# Optional free fallback — https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="cohere/north-mini-code:free"
# Paid OpenAI (optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
AI_FALLBACK_MOCK="true"

S3_ENDPOINT="http://minio:9000"
MINIO_ROOT_USER="REPLACE_ME_MINIO_USER"
MINIO_ROOT_PASSWORD="REPLACE_ME_MINIO_PASSWORD"
S3_ACCESS_KEY="REPLACE_ME_MINIO_USER"
S3_SECRET_KEY="REPLACE_ME_MINIO_PASSWORD"
S3_BUCKET="crucible-artifacts"
S3_REGION="us-east-1"

GITHUB_TOKEN=""
GITHUB_APP_ID=""
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
PORT="3847"
WORKER_PORT="3848"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional local demos only — never ship these values on public hosts
ALLOW_DEMO_ACCOUNTS=false
DEMO_ADMIN_PASSWORD=
DEMO_CANDIDATE_PASSWORD=
ALLOW_MOCK_BILLING=false
# Skip inbox verification on register (local/demo only — never true in production)
DEMO_SKIP_EMAIL_VERIFY=false

# Social login (optional — buttons appear when a provider's pair is set)
# Callback: {APP_URL}/api/auth/oauth/{google|github|apple|facebook|discord|x}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Promote these emails to SUPER_ADMIN on login (verified OAuth or verified password)
# Example: SUPER_ADMIN_EMAILS=you@icloud.com,you@company.com
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_APPLE_SUBS=

# Password signup verification email (optional). Without RESEND_API_KEY, links are
# written to server logs only — never returned to the browser.
RESEND_API_KEY=
AUTH_FROM_EMAIL="Crucible <onboarding@resend.dev>"
