+  // On Vercel there is no Docker daemon — leave QUEUED for an attached worker.
+  // Local/dev and dedicated worker hosts process immediately (worker also polls).
+  const processHere = process.env.VERCEL !== "1" && process.env.JUDGE_DEFER_LOCAL !== "true";
