+    if (src) {
+      const harnessPath = path.join(params.rootPath, "tests", "_hidden_run.ts");
+      await fs.mkdir(path.dirname(harnessPath), { recursive: true });
+      await fs.writeFile(harnessPath, src, "utf8");
+    }
+  }
+
+  const meta = params.auditMeta as { customCases?: CustomCase[] } | null;
+  const customCases = meta?.customCases;
+  if (customCases?.length) {
+    const testsDir = path.join(params.rootPath, "tests");
+    await fs.mkdir(testsDir, { recursive: true });
+    await fs.writeFile(path.join(testsDir, "custom_cases.json"), JSON.stringify(customCases, null, 2), "utf8");
+    if (lang === "python") {
+      await fs.writeFile(path.join(testsDir, "custom_run.py"), customPyRunnerSource(), "utf8");
+    } else {
+      await fs.writeFile(path.join(testsDir, "custom_run.ts"), customTsRunnerSource(), "utf8");
+    }
+  }
+}
