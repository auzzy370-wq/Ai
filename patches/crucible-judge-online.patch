Resolve stored workspace paths to absolute host paths before docker
run so the worker can mount coding workspaces created with relative
storage/ paths.
---
 src/server/execution/runner.ts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/server/execution/runner.ts b/src/server/execution/runner.ts
index bbb2497..11ddc43 100644
--- a/src/server/execution/runner.ts
+++ b/src/server/execution/runner.ts
@@ -384,6 +384,8 @@ async function runInDocker(job: {
   // Candidate code never gets host network. Deploy checks may use bridge only.
   const network = job.networkMode === "egress-limited" ? "bridge" : "none";
   const inner = parseAllowlistedArgv(job.command);
+  // Docker requires an absolute host path for bind mounts (DB may store relative roots).
+  const hostRoot = path.resolve(job.workspace.rootPath);
   const { spawn } = await import("child_process");
   return new Promise<{ stdout: string; stderr: string; exitCode: number; timedOut: boolean }>((resolve) => {
     const child = spawn(
@@ -407,7 +409,7 @@ async function runInDocker(job: {
         "--cap-drop",
         "ALL",
         "-v",
-        `${job.workspace.rootPath}:/workspace:ro`,
+        `${hostRoot}:/workspace:ro`,
         "-w",
         "/workspace",
         // Do not forward host env into the container
