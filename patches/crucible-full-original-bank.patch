+  // Opt into hand-authored-only with ?view=core.
+  const coreOnlyView = sp.view === "core";
+  const includeGenerated = !coreOnlyView;
+  const coreOnly = coreOnlyView
+    ? {
         NOT: {
           OR: [{ slug: { startsWith: "q-" } }, { slug: { startsWith: "exp-" } }],
         },
-      };
+      }
+    : {};
 
