diff --git a/src/app/(app)/challenges/[slug]/page.tsx b/src/app/(app)/challenges/[slug]/page.tsx
new file mode 100644
index 0000000..18a35da
--- /dev/null
+++ b/src/app/(app)/challenges/[slug]/page.tsx
@@ -0,0 +1,182 @@
+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { prisma } from "@/lib/db";
+import {
+  breadcrumbJsonLd,
+  jsonLdScript,
+  pageMetadata,
+  siteUrl,
+} from "@/lib/seo";
+import { trackLabel } from "@/lib/tracks";
+import { getSessionUser } from "@/server/auth/session";
+
+export const dynamic = "force-dynamic";
+
+async function loadChallenge(slug: string) {
+  return prisma.challenge.findFirst({
+    where: { slug, isPublished: true },
+    select: {
+      slug: true,
+      title: true,
+      summary: true,
+      description: true,
+      type: true,
+      track: true,
+      difficulty: true,
+      tags: true,
+      companies: true,
+      languages: true,
+      avgMinutes: true,
+      isPremium: true,
+      frequency: true,
+      updatedAt: true,
+    },
+  });
+}
+
+export async function generateMetadata({
+  params,
+}: {
+  params: Promise<{ slug: string }>;
+}): Promise<Metadata> {
+  const { slug } = await params;
+  const challenge = await loadChallenge(slug).catch(() => null);
+  if (!challenge) {
+    return pageMetadata({
+      title: "Challenge not found",
+      description: "This practice challenge is unavailable.",
+      path: `/challenges/${slug}`,
+      noIndex: true,
+    });
+  }
+  const companyBit = challenge.companies[0] ? ` · ${challenge.companies[0]}-style` : "";
+  const desc =
+    challenge.summary?.slice(0, 155) ||
+    `Practice ${challenge.title} — ${trackLabel(challenge.track)} coding challenge on Crucible.`;
+  return pageMetadata({
+    title: `${challenge.title}${companyBit} practice problem`,
+    description: desc,
+    path: `/challenges/${challenge.slug}`,
+    keywords: [
+      challenge.title,
+      ...challenge.tags.slice(0, 8),
+      ...challenge.companies.slice(0, 4),
+      "coding interview practice",
+      trackLabel(challenge.track),
+      "software engineer prep",
+    ],
+  });
+}
+
+export default async function ChallengeSeoPage({ params }: { params: Promise<{ slug: string }> }) {
+  const { slug } = await params;
+  const challenge = await loadChallenge(slug);
+  if (!challenge) notFound();
+
+  const user = await getSessionUser().catch(() => null);
+  const blurb =
+    challenge.description?.replace(/\s+/g, " ").trim().slice(0, 600) ||
+    challenge.summary ||
+    "Practice this challenge with public tests, then submit when the judge is online.";
+
+  const jsonLd = {
+    "@context": "https://schema.org",
+    "@type": "LearningResource",
+    name: challenge.title,
+    description: challenge.summary || blurb,
+    url: siteUrl(`/challenges/${challenge.slug}`),
+    learningResourceType: "Practice problem",
+    educationalLevel: `Difficulty ${challenge.difficulty}`,
+    timeRequired: `PT${Math.max(15, challenge.avgMinutes || 60)}M`,
+    keywords: [...challenge.tags, ...challenge.companies].join(", "),
+    inLanguage: "en",
+    isAccessibleForFree: !challenge.isPremium,
+    provider: { "@type": "Organization", name: "Crucible", url: siteUrl("/") },
+  };
+
+  return (
+    <main className="animate-rise mx-auto max-w-3xl space-y-8 px-1 py-4 sm:px-0">
+      <script type="application/ld+json" dangerouslySetInnerHTML={jsonLdScript(jsonLd)} />
+      <script
+        type="application/ld+json"
+        dangerouslySetInnerHTML={jsonLdScript(
+          breadcrumbJsonLd([
+            { name: "Home", path: "/" },
+            { name: "Challenges", path: "/challenges" },
+            { name: challenge.title, path: `/challenges/${challenge.slug}` },
+          ]),
+        )}
+      />
+
+      <nav className="font-mono text-[11px] text-slate-500">
+        <Link href="/challenges" className="hover:text-slate-800">
+          Challenges
+        </Link>
+        <span className="mx-2">/</span>
+        <span className="text-slate-700">{challenge.slug}</span>
+      </nav>
+
+      <header className="space-y-3">
+        <p className="font-mono text-xs tracking-[0.28em] text-[var(--brand)]">PRACTICE PROBLEM</p>
+        <h1 className="font-serif-display text-3xl text-slate-900 sm:text-4xl">{challenge.title}</h1>
+        <p className="max-w-2xl text-base text-slate-600">{challenge.summary}</p>
+        <div className="flex flex-wrap gap-2">
+          <Badge variant="brand">{trackLabel(challenge.track)}</Badge>
+          <Badge>Difficulty {challenge.difficulty}</Badge>
+          <Badge>~{challenge.avgMinutes || 60} min</Badge>
+          {challenge.isPremium ? <Badge variant="amber">Premium</Badge> : <Badge variant="emerald">Free</Badge>}
+          {challenge.companies.slice(0, 4).map((c) => (
+            <Badge key={c}>{c}</Badge>
+          ))}
+        </div>
+      </header>
+
+      <section className="space-y-3 rounded-2xl border border-slate-200 bg-white/80 p-5">
+        <h2 className="text-lg font-semibold text-slate-900">What you&apos;ll practice</h2>
+        <p className="text-sm leading-relaxed text-slate-700">{blurb}{blurb.length >= 600 ? "…" : ""}</p>
+        {challenge.tags.length > 0 && (
+          <div className="flex flex-wrap gap-2 pt-1">
+            {challenge.tags.slice(0, 12).map((t) => (
+              <Badge key={t} variant="amber">
+                {t}
+              </Badge>
+            ))}
+          </div>
+        )}
+        {challenge.languages.length > 0 && (
+          <p className="font-mono text-xs text-slate-500">
+            Languages: {challenge.languages.slice(0, 8).join(", ")}
+          </p>
+        )}
+      </section>
+
+      <section className="flex flex-wrap gap-3">
+        {user ? (
+          <Link href="/challenges">
+            <Button>Open in problem bank</Button>
+          </Link>
+        ) : (
+          <>
+            <Link href={`/register?next=${encodeURIComponent(`/challenges/${challenge.slug}`)}`}>
+              <Button>Start practicing free</Button>
+            </Link>
+            <Link href="/challenges">
+              <Button variant="secondary">Browse all challenges</Button>
+            </Link>
+          </>
+        )}
+        <Link href="/jobs">
+          <Button variant="outline">See related jobs</Button>
+        </Link>
+      </section>
+
+      <p className="text-xs text-slate-500">
+        Part of Crucible&apos;s interview-prep bank — coding, systems, and cybersecurity practice with timed mocks and
+        shareable qualification profiles.
+      </p>
+    </main>
+  );
+}
