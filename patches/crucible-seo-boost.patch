new file mode 100644
index 0000000..dfbdc59
--- /dev/null
+++ b/src/lib/seo.ts
@@ -0,0 +1,143 @@
+import type { Metadata } from "next";
+
+const PRODUCTION_HOST = "https://crucible-arena-rho.vercel.app";
+
+/** Canonical site origin for metadata, sitemap, and JSON-LD. */
+export function siteOrigin() {
+  const raw =
+    process.env.NEXT_PUBLIC_APP_URL ||
+    process.env.APP_URL ||
+    process.env.CURSOR_APP_URL ||
+    PRODUCTION_HOST;
+  return raw.replace(/\/$/, "");
+}
+
+export function siteUrl(path = "/") {
+  const p = path.startsWith("/") ? path : `/${path}`;
+  return `${siteOrigin()}${p === "/" ? "" : p}`;
+}
+
+export const SITE_NAME = "Crucible";
+export const SITE_TAGLINE = "Learn the craft. Hire the proof.";
+
+export const DEFAULT_DESCRIPTION =
+  "Practice software engineering and cybersecurity with lessons, a curated coding problem bank, timed interview mocks, and shareable qualification profiles — plus official job links from top tech careers boards.";
+
+const OG_IMAGE = {
+  url: "/brand/crucible-lockup.png",
+  width: 1200,
+  height: 630,
+  alt: "Crucible — engineering craft practice and hiring proof",
+} as const;
+
+type PageMetaInput = {
+  title: string;
+  description: string;
+  path: string;
+  keywords?: string[];
+  noIndex?: boolean;
+  image?: string;
+};
+
+/** Build consistent Metadata for a public page. */
+export function pageMetadata(input: PageMetaInput): Metadata {
+  const url = siteUrl(input.path);
+  const image = input.image || OG_IMAGE.url;
+  const title = input.title;
+
+  return {
+    title,
+    description: input.description,
+    keywords: input.keywords,
+    alternates: { canonical: url },
+    robots: input.noIndex
+      ? { index: false, follow: false }
+      : { index: true, follow: true, googleBot: { index: true, follow: true, "max-image-preview": "large" } },
+    openGraph: {
+      type: "website",
+      locale: "en_US",
+      url,
+      siteName: SITE_NAME,
+      title: `${title} · ${SITE_NAME}`,
+      description: input.description,
+      images: [{ ...OG_IMAGE, url: image.startsWith("http") ? image : siteUrl(image) }],
+    },
+    twitter: {
+      card: "summary_large_image",
+      title: `${title} · ${SITE_NAME}`,
+      description: input.description,
+      images: [image.startsWith("http") ? image : siteUrl(image)],
+    },
+  };
+}
+
+export function jsonLdScript(data: Record<string, unknown> | Record<string, unknown>[]) {
+  return {
+    __html: JSON.stringify(data).replace(/</g, "\\u003c"),
+  };
+}
+
+export function organizationJsonLd() {
+  return {
+    "@context": "https://schema.org",
+    "@type": "Organization",
+    name: SITE_NAME,
+    url: siteOrigin(),
+    logo: siteUrl("/brand/crucible-mark.png"),
+    description: DEFAULT_DESCRIPTION,
+    sameAs: [] as string[],
+  };
+}
+
+export function websiteJsonLd() {
+  return {
+    "@context": "https://schema.org",
+    "@type": "WebSite",
+    name: SITE_NAME,
+    url: siteOrigin(),
+    description: DEFAULT_DESCRIPTION,
+    potentialAction: {
+      "@type": "SearchAction",
+      target: {
+        "@type": "EntryPoint",
+        urlTemplate: `${siteOrigin()}/challenges?q={search_term_string}`,
+      },
+      "query-input": "required name=search_term_string",
+    },
+  };
+}
+
+export function breadcrumbJsonLd(items: { name: string; path: string }[]) {
+  return {
+    "@context": "https://schema.org",
+    "@type": "BreadcrumbList",
+    itemListElement: items.map((item, i) => ({
+      "@type": "ListItem",
+      position: i + 1,
+      name: item.name,
+      item: siteUrl(item.path),
+    })),
+  };
+}
+
+export function profileJsonLd(input: {
+  name: string;
+  slug: string;
+  headline?: string | null;
+  bio?: string | null;
+  skills: string[];
+}) {
+  return {
+    "@context": "https://schema.org",
+    "@type": "ProfilePage",
+    name: `${input.name} — qualification profile`,
+    url: siteUrl(`/u/${input.slug}`),
+    mainEntity: {
+      "@type": "Person",
+      name: input.name,
+      description: input.headline || input.bio || undefined,
+      url: siteUrl(`/u/${input.slug}`),
+      knowsAbout: input.skills.length ? input.skills : undefined,
+    },
+  };
+}
