@@ -0,0 +1,69 @@
+import type { MetadataRoute } from "next";
+import { prisma } from "@/lib/db";
+import { siteUrl } from "@/lib/seo";
+
+export const dynamic = "force-dynamic";
+
+/** Only URLs that guests (and Google) can open without a login wall. */
+const STATIC: {
+  path: string;
+  changeFrequency: MetadataRoute.Sitemap[0]["changeFrequency"];
+  priority: number;
+}[] = [
+  { path: "/", changeFrequency: "weekly", priority: 1 },
+  { path: "/learn", changeFrequency: "weekly", priority: 0.9 },
+  { path: "/challenges", changeFrequency: "daily", priority: 0.95 },
+  { path: "/jobs", changeFrequency: "hourly", priority: 0.9 },
+  { path: "/security", changeFrequency: "monthly", priority: 0.45 },
+  { path: "/pricing", changeFrequency: "monthly", priority: 0.7 },
+];
+
+export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
+  const now = new Date();
+  const entries: MetadataRoute.Sitemap = STATIC.map((s) => ({
+    url: siteUrl(s.path),
+    lastModified: now,
+    changeFrequency: s.changeFrequency,
+    priority: s.priority,
+  }));
+
+  try {
+    const [profiles, challenges] = await Promise.all([
+      prisma.candidateProfile.findMany({
+        where: { publicEnabled: true, publicSlug: { not: null } },
+        select: { publicSlug: true, updatedAt: true },
+        take: 2000,
+        orderBy: { updatedAt: "desc" },
+      }),
+      prisma.challenge.findMany({
+        where: { isPublished: true },
+        select: { slug: true, updatedAt: true },
+        take: 8000,
