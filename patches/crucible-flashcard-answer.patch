+]);
+
+function tokens(text: string) {
+  return text
+    .toLowerCase()
+    .replace(/[^a-z0-9+\-#.\s]/g, " ")
+    .split(/\s+/)
+    .map((t) => t.trim())
+    .filter((t) => t.length > 1 && !STOP.has(t));
+}
+
+/** Loose overlap score so typed answers get instant feedback before self-grade. */
+function scoreAnswer(user: string, model: string) {
+  const u = tokens(user);
+  const m = tokens(model);
+  if (!u.length || !m.length) return { pct: 0, hits: 0, total: m.length };
+  const set = new Set(m);
+  const hits = u.filter((t) => set.has(t)).length;
+  const pct = Math.round((hits / Math.max(set.size, 1)) * 100);
+  return { pct: Math.min(100, pct), hits, total: set.size };
+}
+
+function shuffle<T>(arr: T[]) {
+  const out = [...arr];
+  for (let i = out.length - 1; i > 0; i -= 1) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [out[i], out[j]] = [out[j]!, out[i]!];
+  }
+  return out;
+}
+
+function buildChoices(card: FlashCard, deck: FlashCard[]) {
+  const distractors = deck
+    .filter((c) => c.id !== card.id && c.back.trim() && c.back.trim() !== card.back.trim())
+    .map((c) => c.back.trim());
+  const uniq = [...new Set(distractors)];
+  const picks = shuffle(uniq).slice(0, 3);
+  return shuffle([card.back, ...picks]);
+}
