+/**
+ * College-course framing for lesson tracks and study plans.
+ * Turns sequenced lessons into units, weeks, and lecture sessions.
+ */
+
+export type CourseUnitDef = {
+  id: string;
+  week: string;
+  title: string;
+  blurb: string;
+};
+
+export type CourseProfile = {
+  code: string;
+  title: string;
+  department: string;
+  term: string;
+  credits: number;
+  format: string;
+  outcome: string;
+  units: CourseUnitDef[];
+};
+
+export const INTERVIEW_COURSE: CourseProfile = {
+  code: "CRUC-201",
+  title: "Interview Craft",
+  department: "Software Engineering",
+  term: "Full term · self-paced",
+  credits: 3,
+  format: "Lecture + lab",
+  outcome: "Walk a real interview loop with a repeatable process — coding, design, and behavioral.",
+  units: [
+    {
+      id: "foundations",
+      week: "Weeks 1–2",
+      title: "Unit I · Foundations",
+      blurb: "How loops work, the live-coding framework, and complexity you can say out loud.",
+    },
+    {
+      id: "patterns",
+      week: "Weeks 3–4",
+      title: "Unit II · Patterns",
+      blurb: "The DSA patterns that show up most — then drill them under a clock.",
+    },
+    {
+      id: "rounds",
+      week: "Weeks 5–6",
+      title: "Unit III · Rounds",
+      blurb: "System design, behavioral STAR, and offer-day judgment.",
+    },
+  ],
+};
+
+export const AI_COURSE: CourseProfile = {
+  code: "CRUC-310",
+  title: "AI Craft",
+  department: "Applied AI",
+  term: "Full term · self-paced",
+  credits: 4,
+  format: "Lecture + studio",
+  outcome: "Ship LLM features with prompts, tools, retrieval, evals, and safety — not vibes.",
+  units: [
+    {
+      id: "foundations",
+      week: "Weeks 1–2",
+      title: "Unit I · Foundations",
+      blurb: "Context windows, prompting, and message roles that survive production.",
+    },
+    {
+      id: "builder",
+      week: "Weeks 3–5",
+      title: "Unit II · Builder",
+      blurb: "Structured output, APIs, tools, and retrieval you can wire into an app.",
+    },
+    {
+      id: "production",
+      week: "Weeks 6–8",
+      title: "Unit III · Production",
+      blurb: "Agents, evals, safety, cost, and failure modes before you ship.",
+    },
+  ],
+};
+
+export function courseProfileForPlan(slug: string): CourseProfile | null {
+  if (slug === "interview-craft") return INTERVIEW_COURSE;
+  if (slug === "ai-craft") return AI_COURSE;
+  return null;
+}
+
+export function courseProfileForTrack(track: "interview" | "ai"): CourseProfile {
+  return track === "interview" ? INTERVIEW_COURSE : AI_COURSE;
+}
+
+export function creditsFromMinutes(totalMinutes: number) {
+  // ~45 min ≈ 1 credit-hour feel for self-paced courses
+  return Math.max(1, Math.round(totalMinutes / 45));
+}
+
+export function lectureIndexLabel(index: number, total: number) {
+  return `Lecture ${index + 1} of ${total}`;
+}
+
+export function unitForLevel(profile: CourseProfile, level: string) {
+  return profile.units.find((u) => u.id === level) ?? profile.units[0]!;
+}
