Subject: [PATCH] Hide AI vs Human until the competition bench is ready

Remove the nav entry, redirect /ai-vs-human to Learn, and drop lesson
CTAs that pointed learners at the unfinished surface.
---
 src/app/(app)/ai-vs-human/page.tsx   | 10 ++++------
 src/components/layout/app-shell.tsx  |  2 --
 src/server/learning/ai-curriculum.ts |  8 ++++----
 3 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/src/app/(app)/ai-vs-human/page.tsx b/src/app/(app)/ai-vs-human/page.tsx
index 8b215f6..e81f878 100644
--- a/src/app/(app)/ai-vs-human/page.tsx
+++ b/src/app/(app)/ai-vs-human/page.tsx
@@ -1,8 +1,6 @@
-import { CANDIDATE_ROLES, STAFF_ROLES } from "@/lib/access";
-import { requirePageRoles } from "@/server/auth/page-guard";
-import { AiVsHumanClient } from "@/components/competition/ai-vs-human-client";
+import { redirect } from "next/navigation";
 
-export default async function AiVsHumanPage() {
-  await requirePageRoles([...CANDIDATE_ROLES, ...STAFF_ROLES]);
-  return <AiVsHumanClient />;
+/** AI vs Human stays out of the product until the bench is ready to ship. */
+export default function AiVsHumanPage() {
+  redirect("/learn");
 }
