+
+export function getCareerPath(slug: string) {
+  return CAREER_PATHS.find((p) => p.slug === slug) ?? null;
+}
+
+export function planSlugsForCareer(path: CareerPath) {
+  return [...new Set(path.stages.map((s) => s.planSlug).filter(Boolean) as string[])];
+}
+
+export type CareerPathProgress = {
+  path: CareerPath;
+  stageStats: {
+    id: string;
+    done: number;
+    total: number;
+    percent: number;
+    complete: boolean;
+    enrolled: boolean;
+  }[];
+  percent: number;
+  nextStageId: string | null;
+};
+
+export function scoreCareerProgress(
+  path: CareerPath,
+  enrollments: Map<string, { completedSlugs: string[] }>,
+  planTotals: Map<string, number>,
+): CareerPathProgress {
+  const stageStats = path.stages.map((stage) => {
+    if (!stage.planSlug) {
+      return {
+        id: stage.id,
+        done: 0,
+        total: 0,
+        percent: 0,
+        complete: false,
+        enrolled: false,
+      };
+    }
+    const enr = enrollments.get(stage.planSlug);
+    const total = planTotals.get(stage.planSlug) ?? 0;
+    const done = enr?.completedSlugs?.length ?? 0;
+    const complete = total > 0 && done >= total;
+    return {
+      id: stage.id,
+      done,
+      total,
+      percent: total ? Math.round((Math.min(done, total) / total) * 100) : 0,
+      complete,
+      enrolled: Boolean(enr),
+    };
+  });
+
+  const tracked = stageStats.filter((s) => s.total > 0);
+  const percent = tracked.length
+    ? Math.round(tracked.reduce((acc, s) => acc + s.percent, 0) / tracked.length)
+    : 0;
+  const next =
+    path.stages.find((stage) => {
+      const stat = stageStats.find((s) => s.id === stage.id)!;
+      if (!stage.planSlug) return false;
+      return !stat.complete;
+    })?.id ?? path.stages.find((s) => !s.planSlug)?.id ?? null;
+
+  return { path, stageStats, percent, nextStageId: next };
+}
