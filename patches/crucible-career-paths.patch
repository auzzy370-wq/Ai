+import type { Metadata } from "next";
+import { Suspense } from "react";
+import { CANDIDATE_ROLES } from "@/lib/access";
+import { pageMetadata } from "@/lib/seo";
+import { requirePageRolesOrGuest } from "@/server/auth/page-guard";
+import { CareerPathsClient } from "@/components/learn/career-paths-client";
+import { WelcomeSignIn } from "@/components/auth/welcome-sign-in";
+
+export const metadata: Metadata = pageMetadata({
+  title: "Career paths — learn what the job actually needs",
+  description:
+    "Choose a career target and run the courses, practicums, drills, and mocks that teach what that role hires for.",
+  path: "/career",
+  keywords: ["career path", "software engineer roadmap", "interview prep path", "learn for the job"],
+});
+
+export default async function CareerPage() {
+  const user = await requirePageRolesOrGuest("/career", CANDIDATE_ROLES);
+  return (
+    <div className="space-y-6">
+      {!user && (
+        <Suspense fallback={null}>
+          <WelcomeSignIn />
+        </Suspense>
+      )}
+      <Suspense fallback={<p className="text-slate-500">Loading career paths…</p>}>
+        <CareerPathsClient guest={!user} />
+      </Suspense>
+    </div>
+  );
+}
