+"use client";
+
+import Link from "next/link";
+import { useRouter, useSearchParams } from "next/navigation";
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { toast } from "sonner";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { cn } from "@/lib/utils";
+
+type StageStat = {
+  id: string;
+  done: number;
+  total: number;
+  percent: number;
+  complete: boolean;
+  enrolled: boolean;
+};
+
+type Stage = {
+  id: string;
+  kind: string;
+  title: string;
+  teaches: string;
+  href: string;
+  planSlug?: string;
+  durationLabel: string;
+};
+
+type PathCard = {
+  slug: string;
+  title: string;
+  role: string;
+  department: string;
+  blurb: string;
+  outcomes: string[];
+  hiringSignal: string;
+  stages: Stage[];
+  selected: boolean;
+  percent: number;
+  nextStageId: string | null;
+  stageStats: StageStat[];
+  lockedPlanSlugs: string[];
+};
+
+const KIND_LABEL: Record<string, string> = {
+  course: "Lecture course",
+  practicum: "Practicum",
+  drill: "Drill",
+  mock: "Mock",
+  jobs: "Jobs",
+};
+
+export function CareerPathsClient(props: { guest: boolean }) {
+  const router = useRouter();
+  const search = useSearchParams();
+  const pathFromQuery = search.get("path");
+  const [paths, setPaths] = useState<PathCard[]>([]);
+  const [selectedSlug, setSelectedSlug] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [focus, setFocus] = useState<string | null>(pathFromQuery);
+  const autoEnrolled = useRef(false);
+
+  const choose = useCallback(
+    async (pathSlug: string) => {
+      if (props.guest) {
+        router.push(`/register?next=${encodeURIComponent(`/career?path=${pathSlug}`)}`);
+        return;
+      }
+      setBusy(pathSlug);
+      try {
+        const res = await fetch("/api/learn/career", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ pathSlug }),
+        });
+        const json = await res.json();
+        if (!json.ok) throw new Error(json.error?.message || "Could not enroll");
+        setPaths(json.data.paths ?? []);
+        setSelectedSlug(json.data.selectedSlug ?? pathSlug);
+        setFocus(pathSlug);
+        const skipped = json.data.skippedPremium?.length ?? 0;
+        toast.success(
+          skipped
+            ? `Path chosen — enrolled in free stages (${skipped} Premium stage${skipped === 1 ? "" : "s"} locked)`
+            : "Path chosen — courses and practicums enrolled in order",
+        );
+        router.refresh();
+      } catch (e) {
+        toast.error(e instanceof Error ? e.message : "Could not enroll");
+      } finally {
+        setBusy(null);
+      }
+    },
+    [props.guest, router],
+  );
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    try {
+      const res = await fetch("/api/learn/career");
+      const json = await res.json();
+      if (!json.ok) throw new Error(json.error?.message || "Failed");
+      setPaths(json.data.paths ?? []);
+      setSelectedSlug(json.data.selectedSlug ?? null);
+      const active = json.data.active?.slug ?? json.data.selectedSlug ?? null;
+      setFocus((prev) => prev ?? pathFromQuery ?? active ?? json.data.paths?.[0]?.slug ?? null);
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : "Failed to load career paths");
+    } finally {
+      setLoading(false);
+    }
+  }, [pathFromQuery]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  useEffect(() => {
+    if (
+      autoEnrolled.current ||
+      props.guest ||
+      !pathFromQuery ||
+      selectedSlug ||
+      busy ||
+      !paths.some((p) => p.slug === pathFromQuery)
+    ) {
+      return;
+    }
+    autoEnrolled.current = true;
+    void choose(pathFromQuery);
+  }, [props.guest, pathFromQuery, paths, selectedSlug, busy, choose]);
+
+  const active = useMemo(
+    () => paths.find((p) => p.slug === (focus ?? selectedSlug)) ?? paths[0] ?? null,
+    [paths, focus, selectedSlug],
+  );
+
+  if (loading) {
+    return <p className="text-slate-500">Loading career paths…</p>;
+  }
+
+  const nextStage = active?.stages.find((s) => s.id === active.nextStageId) ?? active?.stages[0];
+  const nextStat = active?.stageStats.find((s) => s.id === nextStage?.id);
+
+  return (
+    <div className="animate-rise space-y-8">
+      <header className="space-y-3">
+        <p className="font-mono text-xs tracking-[0.3em] text-orange-700">CAREER PATHS</p>
+        <h1 className="font-serif-display text-2xl sm:text-3xl">Choose the job. We teach the path.</h1>
+        <p className="max-w-2xl text-slate-600">
+          Pick a career target. Crucible enrolls you in the lecture courses and practicums that role actually needs —
+          in order — so it feels like a real program for that job, not a random checklist.
+        </p>
+      </header>
+
+      {selectedSlug && (
+        <section className="rounded-2xl border border-orange-300/60 bg-[var(--surface-elevated)] p-5 sm:p-6">
+          {(() => {
+            const sel = paths.find((p) => p.slug === selectedSlug);
+            if (!sel) return null;
+            const nxt = sel.stages.find((s) => s.id === sel.nextStageId) ?? sel.stages[0];
+            return (
+              <>
+                <div className="flex flex-wrap items-end justify-between gap-3">
+                  <div>
+                    <p className="font-mono text-[11px] uppercase tracking-[0.22em] text-orange-700/80">Your path</p>
+                    <h2 className="mt-1 font-serif-display text-2xl text-slate-900">{sel.title}</h2>
+                    <p className="mt-1 text-sm text-slate-600">{sel.percent}% through the program · {sel.hiringSignal}</p>
+                  </div>
+                  <Badge variant="amber">{sel.role}</Badge>
+                </div>
+                <div className="mt-4 h-2.5 overflow-hidden rounded-full bg-white/80">
+                  <div className="h-full rounded-full bg-orange-500 transition-all" style={{ width: `${sel.percent}%` }} />
+                </div>
+                {nxt && (
+                  <div className="mt-4 flex flex-wrap items-center gap-2">
+                    <Link href={nxt.href}>
+                      <Button>Continue: {nxt.title}</Button>
+                    </Link>
+                    <Button variant="secondary" onClick={() => setFocus(sel.slug)}>
+                      View full syllabus
+                    </Button>
+                  </div>
+                )}
+              </>
+            );
+          })()}
+        </section>
+      )}
+
+      <section className="space-y-3">
+        <div className="flex flex-wrap items-end justify-between gap-2">
+          <h2 className="font-serif-display text-xl text-slate-900">Pick a career</h2>
+          <p className="text-sm text-slate-500">{paths.length} paths · choose one to enroll the syllabus</p>
+        </div>
+        <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
+          {paths.map((p) => (
+            <button
+              key={p.slug}
+              type="button"
+              onClick={() => setFocus(p.slug)}
+              className={cn(
+                "rounded-2xl border p-4 text-left transition",
+                focus === p.slug
+                  ? "border-orange-400 bg-orange-50/80 shadow-sm"
+                  : p.selected
+                    ? "border-emerald-300 bg-emerald-50/50"
+                    : "border-slate-200 bg-white/80 hover:border-orange-300",
+              )}
+            >
+              <div className="flex flex-wrap gap-2">
+                <Badge variant="brand">{p.department}</Badge>
+                {p.selected && <Badge variant="emerald">Active</Badge>}
+                {p.percent > 0 && <Badge variant="amber">{p.percent}%</Badge>}
+              </div>
+              <h3 className="mt-3 font-serif-display text-lg text-slate-900">{p.title}</h3>
+              <p className="mt-1 line-clamp-3 text-sm text-slate-600">{p.blurb}</p>
+              <p className="mt-3 font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">
+                {p.stages.length} stages · {p.role}
+              </p>
+            </button>
+          ))}
+        </div>
+      </section>
+
+      {active && (
+        <section className="space-y-5 rounded-2xl border border-slate-200 bg-white/85 p-5 sm:p-7">
+          <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
+            <div className="max-w-2xl">
+              <div className="flex flex-wrap gap-2">
+                <Badge variant="brand">{active.department}</Badge>
+                <Badge>{active.role}</Badge>
+                {active.selected && <Badge variant="emerald">Your path</Badge>}
+              </div>
+              <h2 className="mt-3 font-serif-display text-2xl text-slate-900">{active.title}</h2>
+              <p className="mt-2 text-slate-600">{active.blurb}</p>
+              <p className="mt-2 text-sm text-slate-500">{active.hiringSignal}</p>
+              <ul className="mt-4 grid gap-2 sm:grid-cols-2">
+                {active.outcomes.map((o) => (
+                  <li key={o} className="rounded-lg border border-slate-200 bg-slate-50/80 px-3 py-2 text-sm text-slate-700">
+                    {o}
+                  </li>
+                ))}
+              </ul>
+            </div>
+            <div className="flex shrink-0 flex-col gap-2">
+              <Button disabled={busy === active.slug} onClick={() => void choose(active.slug)}>
+                {busy === active.slug
+                  ? "Enrolling…"
+                  : props.guest
+                    ? "Sign in to take this path"
+                    : active.selected
+                      ? "Re-sync enrollments"
+                      : "Choose this path"}
+              </Button>
+              {nextStage && (
+                <Link href={nextStage.href}>
+                  <Button variant="secondary" className="w-full">
+                    {active.selected ? "Continue next stage" : "Preview first stage"}
+                  </Button>
+                </Link>
+              )}
+              <Link href="/study-plans">
+                <Button variant="ghost" className="w-full">
+                  Open course catalog →
+                </Button>
+              </Link>
+            </div>
+          </div>
+
+          <div>
+            <div className="mb-2 flex flex-wrap items-end justify-between gap-2">
+              <h3 className="font-serif-display text-lg text-slate-900">Program syllabus</h3>
+              <span className="font-mono text-xs text-slate-500">
+                {active.percent}% complete
+                {nextStat && nextStat.total > 0
+                  ? ` · next ${nextStat.done}/${nextStat.total}`
+                  : ""}
+              </span>
+            </div>
+            <div className="mb-4 h-2 overflow-hidden rounded-full bg-slate-100">
+              <div
+                className="h-full rounded-full bg-orange-500 transition-[width]"
+                style={{ width: `${active.percent}%` }}
+              />
+            </div>
+            <ol className="relative space-y-3 border-l border-orange-200 pl-4">
+              {active.stages.map((stage, idx) => {
+                const stat = active.stageStats.find((s) => s.id === stage.id);
+                const locked = Boolean(stage.planSlug && active.lockedPlanSlugs.includes(stage.planSlug));
+                const isNext = stage.id === active.nextStageId;
+                return (
+                  <li key={stage.id} className="relative">
+                    <span
+                      className={cn(
+                        "absolute -left-[1.4rem] top-4 h-2.5 w-2.5 rounded-full border-2",
+                        stat?.complete
+                          ? "border-emerald-500 bg-emerald-400"
+                          : isNext
+                            ? "border-orange-500 bg-orange-400"
+                            : "border-slate-300 bg-white",
+                      )}
+                    />
+                    <div
+                      className={cn(
+                        "rounded-xl border px-4 py-3",
+                        stat?.complete
+                          ? "border-emerald-200 bg-emerald-50/60"
+                          : isNext
+                            ? "border-orange-400 bg-orange-50/80"
+                            : "border-slate-200 bg-white/90",
+                      )}
+                    >
+                      <div className="flex flex-wrap items-center gap-2">
+                        <span className="font-mono text-[10px] text-slate-500">
+                          Stage {String(idx + 1).padStart(2, "0")}
+                        </span>
+                        <Badge variant="brand">{KIND_LABEL[stage.kind] ?? stage.kind}</Badge>
+                        <Badge>{stage.durationLabel}</Badge>
+                        {stat?.complete && <Badge variant="emerald">Complete</Badge>}
+                        {isNext && !stat?.complete && <Badge variant="amber">Up next</Badge>}
+                        {locked && <Badge variant="amber">Premium</Badge>}
+                      </div>
+                      <h4 className="mt-2 font-medium text-slate-900">{stage.title}</h4>
+                      <p className="mt-1 text-sm text-slate-600">
+                        <span className="font-medium text-slate-800">Teaches: </span>
+                        {stage.teaches}
+                      </p>
+                      {stat && stat.total > 0 && (
+                        <div className="mt-3">
+                          <div className="mb-1 flex justify-between font-mono text-[10px] text-slate-500">
+                            <span>
+                              {stat.done}/{stat.total} items
+                            </span>
+                            <span>{stat.percent}%</span>
+                          </div>
+                          <div className="h-1.5 overflow-hidden rounded-full bg-slate-100">
+                            <div
+                              className="h-full rounded-full bg-orange-500"
+                              style={{ width: `${stat.percent}%` }}
+                            />
+                          </div>
+                        </div>
+                      )}
+                      <div className="mt-3">
+                        <Link href={locked ? "/pricing" : stage.href} className="text-sm text-orange-800 hover:underline">
+                          {locked ? "Unlock Premium to open →" : isNext ? "Enter this stage →" : "Open →"}
+                        </Link>
+                      </div>
+                    </div>
+                  </li>
+                );
+              })}
+            </ol>
+          </div>
+        </section>
+      )}
+    </div>
+  );
+}
