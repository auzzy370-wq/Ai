+import { z } from "zod";
+import { prisma } from "@/lib/db";
+import { AppError } from "@/lib/errors";
+import { jsonOk, withHandler } from "@/server/auth/api";
+import { isPremium, requireUser, getSessionUser } from "@/server/auth/session";
+import { STUDY_PLANS, getStudyPlan } from "@/server/saas/study-plans";
+import {
+  CAREER_PATHS,
+  getCareerPath,
+  planSlugsForCareer,
+  scoreCareerProgress,
+} from "@/server/learning/career-paths";
+
+function readCareerSlug(knowledgeMap: unknown): string | null {
+  if (!knowledgeMap || typeof knowledgeMap !== "object") return null;
+  const career = (knowledgeMap as { careerPath?: { slug?: string } }).careerPath;
+  return career?.slug && typeof career.slug === "string" ? career.slug : null;
+}
+
+async function buildCareerPayload(userId: string | null) {
+  const premium = userId
+    ? isPremium(await prisma.user.findUniqueOrThrow({ where: { id: userId } }))
+    : false;
+
+  const enrollments = userId
+    ? await prisma.studyPlanEnrollment.findMany({ where: { userId } })
+    : [];
+  const enrMap = new Map(enrollments.map((e) => [e.planSlug, { completedSlugs: e.completedSlugs }]));
+  const planTotals = new Map(STUDY_PLANS.map((p) => [p.slug, p.challengeSlugs.length]));
+
+  let selectedSlug: string | null = null;
+  if (userId) {
+    const profile = await prisma.candidateProfile.findUnique({
+      where: { userId },
+      select: { knowledgeMap: true },
+    });
+    selectedSlug = readCareerSlug(profile?.knowledgeMap);
+  }
+
+  const paths = CAREER_PATHS.map((path) => {
+    const progress = scoreCareerProgress(path, enrMap, planTotals);
+    return {
+      ...path,
+      selected: selectedSlug === path.slug,
+      percent: progress.percent,
+      nextStageId: progress.nextStageId,
+      stageStats: progress.stageStats,
+      lockedPlanSlugs: path.stages
+        .map((s) => s.planSlug)
+        .filter((slug): slug is string => {
+          if (!slug) return false;
+          const plan = getStudyPlan(slug);
+          return Boolean(plan?.premium && !premium);
+        }),
+    };
+  });
+
+  return {
+    premium,
+    selectedSlug,
+    paths,
+    active: paths.find((p) => p.selected) ?? null,
+  };
+}
+
+export async function GET() {
+  return withHandler(async () => {
+    const user = await getSessionUser();
+    return jsonOk(await buildCareerPayload(user?.id ?? null));
+  });
+}
+
+const selectSchema = z.object({
+  pathSlug: z.string().min(2),
+});
+
+export async function POST(req: Request) {
+  return withHandler(async () => {
+    const user = await requireUser();
+    const body = selectSchema.parse(await req.json());
+    const path = getCareerPath(body.pathSlug);
+    if (!path) throw new AppError("Career path not found", 404, "NOT_FOUND");
+
+    const premium = isPremium(user);
+    const planSlugs = planSlugsForCareer(path);
+    const enrolled: string[] = [];
+    const skippedPremium: string[] = [];
+
+    for (const slug of planSlugs) {
+      const plan = getStudyPlan(slug);
+      if (!plan) continue;
+      if (plan.premium && !premium) {
+        skippedPremium.push(slug);
+        continue;
+      }
+      await prisma.studyPlanEnrollment.upsert({
+        where: { userId_planSlug: { userId: user.id, planSlug: slug } },
+        create: { userId: user.id, planSlug: slug },
+        update: {},
+      });
+      enrolled.push(slug);
+    }
+
+    const profile = await prisma.candidateProfile.upsert({
+      where: { userId: user.id },
+      create: {
+        userId: user.id,
+        knowledgeMap: { careerPath: { slug: path.slug, enrolledAt: new Date().toISOString() } },
+      },
+      update: {},
+      select: { knowledgeMap: true },
+    });
+
+    const prev =
+      profile.knowledgeMap && typeof profile.knowledgeMap === "object"
+        ? (profile.knowledgeMap as Record<string, unknown>)
+        : {};
+    await prisma.candidateProfile.update({
+      where: { userId: user.id },
+      data: {
+        knowledgeMap: {
+          ...prev,
+          careerPath: { slug: path.slug, enrolledAt: new Date().toISOString() },
+        },
+      },
+    });
+
+    return jsonOk({
+      pathSlug: path.slug,
+      enrolled,
+      skippedPremium,
+      ...(await buildCareerPayload(user.id)),
+    });
+  });
+}
