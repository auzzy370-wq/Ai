+import { homeForRole } from "@/lib/access";
+
+/** Safe post-login destination from `?next=` (same-origin path only). */
+export function safeNextPath(next: string | null | undefined): string | null {
+  if (!next) return null;
+  if (!next.startsWith("/") || next.startsWith("//")) return null;
+  if (next.startsWith("/api") || next.startsWith("/login") || next.startsWith("/register")) return null;
+  return next;
+}
+
+export function postAuthRedirect(role: string, next?: string | null) {
+  return safeNextPath(next) ?? homeForRole(role);
+}
