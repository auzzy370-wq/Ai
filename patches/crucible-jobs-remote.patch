@@ -73,12 +73,47 @@ export function looksLikeEngRole(title: string): boolean {
   );
 }
 
-export type JobFocus = "all" | "engineering" | "cybersecurity";
+export type JobFocus = "all" | "engineering" | "cybersecurity" | "remote";
+
+/** True when title/location/summary clearly advertise remote work. */
+export function isRemotePosting(input: {
+  title?: string | null;
+  location?: string | null;
+  summary?: string | null;
+  team?: string | null;
+}): boolean {
+  const blob = [input.title, input.location, input.summary, input.team].filter(Boolean).join(" ");
+  if (!blob.trim()) return false;
+  if (/\b(not remote|no remote|on-?site only|in-?office only|office only)\b/i.test(blob)) return false;
+  return /\b(remote|work[\s-]?from[\s-]?home|wfh|distributed team|work anywhere|telecommut|remote-?first|remote-?friendly|fully remote)\b/i.test(
+    blob,
+  );
+}
+
+export function normalizeRemoteLocation(location: string, remote: boolean): string {
+  if (!remote) return location;
+  if (/remote/i.test(location)) return location;
+  if (!location || /^see posting$/i.test(location) || /^official careers site$/i.test(location)) {
+    return "Remote";
+  }
+  return `${location} · Remote`;
+}
+
+type FocusableJob = {
+  title: string;
+  location?: string | null;
+  summary?: string | null;
+  team?: string | null;
+  remote?: boolean | null;
+};
 
 /** Filter postings by Jobs focus chip. */
-export function matchesJobFocus(title: string, focus: JobFocus): boolean {
-  if (focus === "all") return looksLikeEngRole(title);
-  if (focus === "cybersecurity") return looksLikeCyberRole(title);
+export function matchesJobFocus(job: FocusableJob | string, focus: JobFocus): boolean {
+  // Back-compat: older callers passed title string only.
+  const row: FocusableJob = typeof job === "string" ? { title: job } : job;
+  if (focus === "remote") return Boolean(row.remote) || isRemotePosting(row);
+  if (focus === "all") return looksLikeEngRole(row.title);
+  if (focus === "cybersecurity") return looksLikeCyberRole(row.title);
   // Engineering: tech roles that are not primarily cyber-titled.
-  return looksLikeEngRole(title) && !looksLikeCyberRole(title);
+  return looksLikeEngRole(row.title) && !looksLikeCyberRole(row.title);
 }
