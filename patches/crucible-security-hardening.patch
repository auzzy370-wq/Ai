 import { NextResponse, type NextRequest } from "next/server";
 import { applySecurityHeaders } from "@/server/security/headers";
+import { assertSameOrigin, isCsrfExemptPath } from "@/server/security/origin";
+import { AppError } from "@/lib/errors";
 
-/** Security headers on every response. Auth is enforced in route/page guards. */
+/** Security headers + CSRF origin checks on mutating API routes. Auth stays in route/page guards. */
 export default function middleware(req: NextRequest) {
+  const path = req.nextUrl.pathname;
+  const method = req.method.toUpperCase();
+  const mutating = method !== "GET" && method !== "HEAD" && method !== "OPTIONS";
+
+  if (path.startsWith("/api/") && mutating && !isCsrfExemptPath(path)) {
+    try {
+      assertSameOrigin(req);
+    } catch (err) {
+      const message = err instanceof AppError ? err.message : "Cross-origin request blocked";
+      const code = err instanceof AppError ? err.code : "CSRF_ORIGIN";
+      const blocked = NextResponse.json(
+        { ok: false, error: { code, message } },
+        { status: 403 },
+      );
+      applySecurityHeaders(blocked);
+      return blocked;
+    }
+  }
+
   const res = NextResponse.next();
