+import type { ReactNode } from "react";
+
+/** Inline **bold** and `code` without raw HTML injection. */
+function InlineMd({ text }: { text: string }) {
+  const parts: ReactNode[] = [];
+  const re = /(\*\*(.+?)\*\*|`([^`]+)`)/g;
+  let last = 0;
+  let m: RegExpExecArray | null;
+  let key = 0;
+  while ((m = re.exec(text))) {
+    if (m.index > last) parts.push(text.slice(last, m.index));
+    if (m[2] != null) {
+      parts.push(
+        <strong key={key++} className="text-slate-900">
+          {m[2]}
+        </strong>,
+      );
+    } else if (m[3] != null) {
+      parts.push(
+        <code
+          key={key++}
+          className="rounded border border-[var(--code-chip-border)] bg-[var(--code-chip-bg)] px-1.5 py-0.5 font-mono text-[11px] font-medium text-[var(--code-chip-fg)]"
+        >
+          {m[3]}
+        </code>,
+      );
+    }
+    last = m.index + m[0].length;
+  }
+  if (last < text.length) parts.push(text.slice(last));
+  return <>{parts}</>;
+}
