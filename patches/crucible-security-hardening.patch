@@ -0,0 +1,49 @@
+import { logger } from "@/lib/logger";
+
+/** True on public hosts where demo/bypass flags must stay off. */
+export function isPublicRuntime() {
+  return (
+    process.env.VERCEL === "1" ||
+    process.env.NODE_ENV === "production" ||
+    process.env.FORCE_PUBLIC_SECURITY === "true"
+  );
+}
+
+/**
+ * Fail closed on dangerous demo flags in public runtimes.
+ * Soft-warns on missing recommended secrets so local/dev still boots.
+ */
+export function assertProductionSecurityEnv() {
+  if (!isPublicRuntime()) return;
+
+  const fatal: string[] = [];
+  const warn: string[] = [];
+
+  const truthy = (v: string | undefined) => ["1", "true", "yes", "on"].includes((v || "").toLowerCase());
+
+  if (truthy(process.env.DEMO_SKIP_EMAIL_VERIFY)) {
+    fatal.push("DEMO_SKIP_EMAIL_VERIFY must be false on public hosts");
+  }
+  if (truthy(process.env.ALLOW_DEMO_ACCOUNTS)) {
+    fatal.push("ALLOW_DEMO_ACCOUNTS must be false on public hosts");
+  }
+  if (truthy(process.env.ALLOW_MOCK_BILLING) && process.env.STRIPE_SECRET_KEY) {
+    warn.push("ALLOW_MOCK_BILLING is on while Stripe is configured — prefer mock off in production");
+  }
+  if (!process.env.SESSION_SECRET || process.env.SESSION_SECRET.length < 16) {
+    warn.push("SESSION_SECRET missing or short — OAuth / signed state will fail closed");
+  }
+  if (!process.env.SETUP_SECRET || process.env.SETUP_SECRET.includes("REPLACE_ME")) {
+    warn.push("SETUP_SECRET unset or placeholder — lock /api/setup before exposing admin bootstrap");
+  }
+  if (!process.env.APP_URL && !process.env.NEXT_PUBLIC_APP_URL) {
+    warn.push("APP_URL / NEXT_PUBLIC_APP_URL unset — CSRF allowlist falls back to request host only");
+  }
+
+  for (const w of warn) logger.warn(`[security-env] ${w}`);
+  if (fatal.length) {
+    const msg = fatal.join("; ");
+    logger.error(`[security-env] refusing boot: ${msg}`);
+    throw new Error(`Security env guard: ${msg}`);
+  }
+}
