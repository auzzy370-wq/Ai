@@ -0,0 +1,251 @@
+"use client";
+
+import Link from "next/link";
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { cn } from "@/lib/utils";
+import type { FlashCard } from "@/server/learning/flashcards";
+
+const KIND_LABEL: Record<FlashCard["kind"], string> = {
+  prompt: "Prompt",
+  pattern: "Pattern",
+  edge: "Edge",
+  company: "Company",
+  requirement: "Requirement",
+  followup: "Follow-up",
+};
+
+function storageKey(slug: string) {
+  return `crucible_flash_${slug}`;
+}
+
+export function FlashcardsClient(props: {
+  slug: string;
+  title: string;
+  summary?: string | null;
+  cards: FlashCard[];
+  challengeHref?: string;
+}) {
+  const [index, setIndex] = useState(0);
+  const [flipped, setFlipped] = useState(false);
+  const [known, setKnown] = useState<Set<string>>(() => new Set());
+
+  useEffect(() => {
+    try {
+      const raw = localStorage.getItem(storageKey(props.slug));
+      if (!raw) return;
+      const parsed = JSON.parse(raw) as { known?: string[] };
+      if (Array.isArray(parsed.known)) setKnown(new Set(parsed.known));
+    } catch {
+      /* ignore */
+    }
+  }, [props.slug]);
+
+  useEffect(() => {
+    try {
+      localStorage.setItem(storageKey(props.slug), JSON.stringify({ known: [...known] }));
+    } catch {
+      /* ignore */
+    }
+  }, [known, props.slug]);
+
+  const card = props.cards[index] ?? null;
+  const progress = props.cards.length
+    ? Math.round((known.size / props.cards.length) * 100)
+    : 0;
+
+  const remaining = useMemo(
+    () => props.cards.map((c, i) => ({ c, i })).filter(({ c }) => !known.has(c.id)),
+    [known, props.cards],
+  );
+
+  const go = useCallback(
+    (next: number) => {
+      if (!props.cards.length) return;
+      const n = ((next % props.cards.length) + props.cards.length) % props.cards.length;
+      setIndex(n);
+      setFlipped(false);
+    },
+    [props.cards.length],
+  );
+
+  function markKnown(yes: boolean) {
+    if (!card) return;
+    setKnown((prev) => {
+      const next = new Set(prev);
+      if (yes) next.add(card.id);
+      else next.delete(card.id);
+      return next;
+    });
+    if (yes) {
+      const nextRemaining = remaining.filter(({ c }) => c.id !== card.id);
+      if (nextRemaining[0]) {
+        setIndex(nextRemaining[0].i);
+        setFlipped(false);
+      } else {
+        go(index + 1);
+      }
+    } else {
+      go(index + 1);
+    }
+  }
+
+  if (!card) {
+    return (
+      <div className="rounded-2xl border border-dashed border-slate-300 px-4 py-16 text-center text-sm text-slate-500">
+        No flash cards for this deck yet.
+      </div>
+    );
+  }
+
+  return (
+    <div className="animate-rise space-y-6">
+      <header className="space-y-2">
+        <p className="font-mono text-xs tracking-[0.28em] text-[var(--brand)]">FLASH CARDS</p>
+        <h1 className="font-serif-display text-2xl text-slate-900 sm:text-3xl">{props.title}</h1>
+        {props.summary ? <p className="max-w-2xl text-slate-600">{props.summary}</p> : null}
+        <div className="flex flex-wrap items-center gap-2 text-xs text-slate-500">
+          <span>
+            Card {index + 1}/{props.cards.length}
+          </span>
+          <span>·</span>
+          <span>{known.size} marked known · {progress}%</span>
+          {props.challengeHref ? (
+            <>
+              <span>·</span>
+              <Link href={props.challengeHref} className="text-orange-800 hover:underline">
+                Open problem
+              </Link>
+            </>
+          ) : null}
+        </div>
+        <div className="h-2 overflow-hidden rounded-full bg-slate-100">
+          <div className="h-full rounded-full bg-[var(--brand)] transition-[width]" style={{ width: `${progress}%` }} />
+        </div>
+      </header>
+
+      <button
+        type="button"
+        onClick={() => setFlipped((f) => !f)}
+        className={cn(
+          "min-h-[240px] w-full rounded-2xl border p-6 text-left transition sm:min-h-[280px]",
+          flipped
+            ? "border-emerald-300/60 bg-emerald-50/80"
+            : "border-orange-300/50 bg-[var(--surface-elevated)] hover:border-orange-400/70",
+        )}
+      >
+        <div className="flex items-center justify-between gap-2">
+          <Badge variant={flipped ? "emerald" : "brand"}>{KIND_LABEL[card.kind]}</Badge>
+          <span className="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">
+            {flipped ? "Answer" : "Tap to flip"}
+          </span>
+        </div>
+        <p className="mt-6 whitespace-pre-wrap text-lg leading-relaxed text-slate-900 sm:text-xl">
+          {flipped ? card.back : card.front}
+        </p>
+      </button>
+
+      <div className="flex flex-wrap gap-2">
+        <Button variant="secondary" onClick={() => go(index - 1)}>
+          Previous
+        </Button>
+        <Button variant="secondary" onClick={() => setFlipped((f) => !f)}>
+          {flipped ? "Show prompt" : "Show answer"}
+        </Button>
+        <Button variant="outline" onClick={() => markKnown(false)}>
+          Again
+        </Button>
+        <Button onClick={() => markKnown(true)}>Know it</Button>
+        <Button variant="secondary" onClick={() => go(index + 1)}>
+          Next
+        </Button>
+      </div>
+
+      {known.size >= props.cards.length && (
+        <div className="rounded-xl border border-emerald-300/50 bg-emerald-50/80 px-4 py-3 text-sm text-emerald-950">
+          Deck clear.{" "}
+          {props.challengeHref ? (
+            <Link href={props.challengeHref} className="font-medium underline">
+              Solve the problem next →
+            </Link>
+          ) : (
+            <Link href="/challenges" className="font-medium underline">
+              Back to practice →
+            </Link>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function FlashcardsHubClient(props: {
+  decks: {
+    slug: string;
+    title: string;
+    summary: string;
+    difficulty: number;
+    tags: string[];
+    cardCount: number;
+  }[];
+}) {
+  const [q, setQ] = useState("");
+  const filtered = useMemo(() => {
+    const needle = q.trim().toLowerCase();
+    if (!needle) return props.decks;
+    return props.decks.filter((d) =>
+      `${d.title} ${d.summary} ${d.tags.join(" ")} ${d.slug}`.toLowerCase().includes(needle),
+    );
+  }, [props.decks, q]);
+
+  return (
+    <div className="animate-rise space-y-6">
+      <header className="space-y-2">
+        <p className="font-mono text-xs tracking-[0.28em] text-[var(--brand)]">FLASH CARDS</p>
+        <h1 className="font-serif-display text-2xl text-slate-900 sm:text-3xl">
+          Drill every problem before you code
+        </h1>
+        <p className="max-w-2xl text-slate-600">
+          Each published challenge gets a free deck — prompt, patterns, edges, and company cues. Progress saves in this
+          browser.
+        </p>
+      </header>
+
+      <input
+        value={q}
+        onChange={(e) => setQ(e.target.value)}
+        placeholder="Filter by title, tag, company pattern…"
+        className="flex h-11 w-full rounded-md border border-slate-300 bg-white px-3 text-sm"
+      />
+
+      <ul className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
+        {filtered.map((d) => (
+          <li key={d.slug}>
+            <Link
+              href={`/flashcards/${d.slug}`}
+              className="block h-full rounded-2xl border border-slate-200 bg-white/80 p-4 transition hover:border-[var(--brand)]/40"
+            >
+              <div className="flex flex-wrap gap-2">
+                <Badge variant="brand">D{d.difficulty}</Badge>
+                <Badge>{d.cardCount} cards</Badge>
+              </div>
+              <h2 className="mt-3 font-medium text-slate-900">{d.title}</h2>
+              <p className="mt-1 line-clamp-2 text-sm text-slate-600">{d.summary}</p>
+              <div className="mt-3 flex flex-wrap gap-1.5">
+                {d.tags.slice(0, 4).map((t) => (
+                  <span key={t} className="rounded border border-slate-200 px-1.5 py-0.5 font-mono text-[10px] text-slate-500">
+                    {t}
+                  </span>
+                ))}
+              </div>
+            </Link>
+          </li>
+        ))}
+      </ul>
+      {!filtered.length && (
+        <p className="text-center text-sm text-slate-500">No decks match that filter.</p>
+      )}
+    </div>
+  );
+}
