+import type { Metadata } from "next";
+import { pageMetadata } from "@/lib/seo";
+import { prisma } from "@/lib/db";
+import { requirePageRolesOrGuest } from "@/server/auth/page-guard";
+import { CANDIDATE_ROLES } from "@/lib/access";
+import { buildChallengeFlashCards } from "@/server/learning/flashcards";
+import { FlashcardsHubClient } from "@/components/learn/flashcards-client";
+
+export const metadata: Metadata = pageMetadata({
+  title: "Flash cards for coding interview problems",
+  description:
+    "Free flash card decks for every published practice problem — prompts, patterns, hidden edges, and company cues.",
+  path: "/flashcards",
+  keywords: ["coding flash cards", "interview drill cards", "algorithm patterns", "leetcode flashcards"],
+});
+
+export const dynamic = "force-dynamic";
+
+export default async function FlashcardsHubPage() {
+  await requirePageRolesOrGuest("/flashcards", [...CANDIDATE_ROLES, "SUPER_ADMIN", "HIRING_MANAGER", "TECHNICAL_REVIEWER"]);
+
+  const challenges = await prisma.challenge.findMany({
+    where: { isPublished: true },
+    select: {
+      slug: true,
+      title: true,
+      summary: true,
+      difficulty: true,
+      tags: true,
+      companies: true,
+      publicRequirements: true,
+      hiddenRequirements: true,
+      hints: true,
+      adaptiveTrack: true,
+      description: true,
+      frequency: true,
+    },
+    orderBy: [{ frequency: "desc" }, { updatedAt: "desc" }],
+    take: 240,
+  });
+
+  const decks = challenges.map((c) => ({
+    slug: c.slug,
+    title: c.title,
+    summary: c.summary,
+    difficulty: c.difficulty,
+    tags: c.tags,
+    cardCount: buildChallengeFlashCards(c).length,
+  }));
+
+  return <FlashcardsHubClient decks={decks} />;
+}
