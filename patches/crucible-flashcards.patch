+export type FlashCard = {
+  id: string;
+  front: string;
+  back: string;
+  kind: "prompt" | "pattern" | "edge" | "company" | "requirement" | "followup";
+};
+
+export type FlashDeckMeta = {
+  slug: string;
+  title: string;
+  summary: string;
+  difficulty: number;
+  tags: string[];
+  companies: string[];
+  cardCount: number;
+};
+
+/** Short pattern cues keyed by challenge tags — keeps decks useful, not just restated titles. */
+const PATTERN_CUES: Record<string, { front: string; back: string }> = {
+  "hash-table": {
+    front: "When is a hash map the right first move?",
+    back: "Need O(1) lookups / complements / frequency counts while scanning once (Two Sum, anagrams, prefix maps).",
+  },
+  array: {
+    front: "Array interview default toolkit?",
+    back: "Two pointers, sliding window, prefix sums, sorting + scan, and hash maps for complements.",
+  },
+  stack: {
+    front: "When do you reach for a stack?",
+    back: "Nested structure, matching pairs, monotonic next-greater/smaller, or undo/path reconstruction.",
+  },
+  "sliding-window": {
+    front: "Sliding window vs two pointers?",
+    back: "Window grows/shrinks over a contiguous segment to maintain a property (coverage, uniqueness, sum).",
+  },
+  dp: {
+    front: "DP interview signal?",
+    back: "Optimal substructure + overlapping subproblems — define state, transition, base cases, then optimize space.",
+  },
+  graph: {
+    front: "Graph traversal pick?",
+    back: "BFS for shortest unweighted paths / levels; DFS/recursion for connectivity, cycles, topo order.",
+  },
+  "topo-sort": {
+    front: "Topological sort use case?",
+    back: "Ordering tasks with prerequisites (course schedule) — Kahn BFS or DFS finish times; detect cycles.",
+  },
+  tree: {
+    front: "Binary tree recursion template?",
+    back: "Define return value per node, recurse left/right, combine — watch null bases and balanced vs BST rules.",
+  },
+  heap: {
+    front: "When is a heap (priority queue) ideal?",
+    back: "Repeated min/max extraction — top-K, merge K lists, scheduling by soonest deadline.",
+  },
+  "linked-list": {
+    front: "Linked list interview patterns?",
+    back: "Dummy head, two pointers (fast/slow), reverse in place, and careful null/tail updates.",
+  },
+  string: {
+    front: "String problem first questions?",
+    back: "Charset size? Contiguous vs subsequence? Need counts, stack matching, or sliding window coverage?",
+  },
+  design: {
+    front: "Design-a-structure interview focus?",
+    back: "State the ops + complexity targets, pick backing structures, then handle edge cases and amortization.",
+  },
+  dfs: {
+    front: "DFS vs BFS quick rule?",
+    back: "DFS explores deep paths / backtracking; BFS explores layers and finds shortest unweighted routes.",
+  },
+  bfs: {
+    front: "BFS classic uses?",
+    back: "Level-order trees, shortest path in unweighted graphs, multi-source flood fill.",
+  },
+  sorting: {
+    front: "Why sort first in interviews?",
+    back: "Turns overlaps/pairs/ranges into a linear scan — merge intervals, two-sum variants, greedy choice.",
+  },
+  trie: {
+    front: "When does a trie win?",
+    back: "Prefix queries, dictionary word breaks, and autocomplete over many strings.",
+  },
+  queue: {
+    front: "Queue interview cue?",
+    back: "FIFO ordering, sliding-window maxima with deque, or BFS frontiers.",
+  },
+  easy: {
+    front: "Easy-round expectation?",
+    back: "Correct brute force fast, then improve — communicate complexity and edge cases clearly.",
+  },
+  medium: {
+    front: "Medium-round expectation?",
+    back: "Pick the right pattern quickly, code cleanly, and prove edges with tests.",
+  },
+  hard: {
+    front: "Hard-round survival tip?",
+    back: "Clarify constraints, propose a workable plan, implement the core path, then harden edges if time.",
+  },
+  coding: {
+    front: "What does a coding evidence session grade?",
+    back: "Public examples + hidden harness — correctness under edges and time/memory limits.",
+  },
+};
+
+function asHints(raw: unknown): string[] {
+  if (!raw) return [];
+  if (Array.isArray(raw)) return raw.map(String).filter(Boolean).slice(0, 6);
+  if (typeof raw === "string") {
+    try {
+      const parsed = JSON.parse(raw);
+      return asHints(parsed);
+    } catch {
+      return raw.trim() ? [raw.trim()] : [];
+    }
+  }
+  return [];
+}
+
+export function buildChallengeFlashCards(input: {
+  slug: string;
+  title: string;
+  summary: string | null;
+  description?: string | null;
+  tags: string[];
+  companies: string[];
+  publicRequirements?: unknown;
+  hiddenRequirements?: unknown;
+  hints?: unknown;
+  adaptiveTrack?: unknown;
+}): FlashCard[] {
+  const cards: FlashCard[] = [];
+  const push = (card: Omit<FlashCard, "id">) => {
+    cards.push({ ...card, id: `${input.slug}-${card.kind}-${cards.length}` });
+  };
+
+  push({
+    kind: "prompt",
+    front: `What is “${input.title}” asking for?`,
+    back: input.summary?.trim() || "Solve the stated coding/mission prompt with correct edge handling.",
+  });
+
+  const followUp = input.description?.match(/##\s*Follow-up\s*\n+([\s\S]*?)(?:\n##|$)/i)?.[1]?.trim();
+  if (followUp) {
+    push({
+      kind: "followup",
+      front: `Follow-up for ${input.title}?`,
+      back: followUp.replace(/\s+/g, " ").slice(0, 320),
+    });
+  }
+
+  for (const tag of input.tags) {
+    const cue = PATTERN_CUES[tag.toLowerCase()];
+    if (!cue) continue;
+    push({ kind: "pattern", front: cue.front, back: `${cue.back}\n\nSeen in: ${input.title}` });
+  }
+
+  const publics = asHints(input.publicRequirements);
+  for (const req of publics.slice(0, 3)) {
+    push({
+      kind: "requirement",
+      front: `Public requirement on ${input.title}?`,
+      back: req,
+    });
+  }
+
+  const hiddens = asHints(input.hiddenRequirements);
+  for (const req of hiddens.slice(0, 3)) {
+    push({
+      kind: "edge",
+      front: `Hidden edge to watch on ${input.title}?`,
+      back: req,
+    });
+  }
+
+  for (const hint of asHints(input.hints).slice(0, 4)) {
+    push({
+      kind: "edge",
+      front: `Hint for ${input.title}`,
+      back: hint,
+    });
+  }
+
+  if (Array.isArray(input.adaptiveTrack)) {
+    for (const step of input.adaptiveTrack.slice(0, 3) as { title?: string; criteria?: string }[]) {
+      if (!step?.title) continue;
+      push({
+        kind: "requirement",
+        front: `Level goal: ${step.title}`,
+        back: step.criteria || `Progress on ${input.title}`,
+      });
+    }
+  }
+
+  if (input.companies.length) {
+    push({
+      kind: "company",
+      front: `Where does “${input.title}” show up?`,
+      back: `Commonly tagged at ${input.companies.slice(0, 6).join(", ")}. Use it as company-loop warm-up before a timed mock.`,
+    });
+  }
+
+  // Deduplicate near-identical fronts
+  const seen = new Set<string>();
+  return cards.filter((c) => {
+    const key = c.front.toLowerCase();
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+}
+
+export function buildLessonFlashCards(input: {
+  slug: string;
+  title: string;
+  summary: string;
+  skills: string[];
+}): FlashCard[] {
+  const cards: FlashCard[] = [
+    {
+      id: `${input.slug}-prompt-0`,
+      kind: "prompt",
+      front: `What is “${input.title}” about?`,
+      back: input.summary,
+    },
+  ];
+  for (const [i, skill] of input.skills.entries()) {
+    cards.push({
+      id: `${input.slug}-pattern-${i}`,
+      kind: "pattern",
+      front: `Skill from ${input.title}?`,
+      back: skill.replaceAll("-", " "),
+    });
+  }
+  return cards;
+}
