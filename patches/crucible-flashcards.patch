+import type { Metadata } from "next";
+import { notFound } from "next/navigation";
+import { CANDIDATE_ROLES } from "@/lib/access";
+import { prisma } from "@/lib/db";
+import { pageMetadata } from "@/lib/seo";
+import { requirePageRolesOrGuest } from "@/server/auth/page-guard";
+import { buildChallengeFlashCards, buildLessonFlashCards } from "@/server/learning/flashcards";
+import { FlashcardsClient } from "@/components/learn/flashcards-client";
+import { INTERVIEW_LESSONS } from "@/server/learning/interview-curriculum";
+import { AI_LESSONS } from "@/server/learning/ai-curriculum";
+
+export const dynamic = "force-dynamic";
+
+export async function generateMetadata({
+  params,
+}: {
+  params: Promise<{ slug: string }>;
+}): Promise<Metadata> {
+  const { slug } = await params;
+  const challenge = await prisma.challenge
+    .findFirst({ where: { slug, isPublished: true }, select: { title: true, summary: true } })
+    .catch(() => null);
+  if (challenge) {
+    return pageMetadata({
+      title: `${challenge.title} flash cards`,
+      description: challenge.summary || `Drill patterns and edges for ${challenge.title}.`,
+      path: `/flashcards/${slug}`,
+      keywords: [challenge.title, "flash cards", "interview drill"],
+    });
+  }
+  const lesson =
+    INTERVIEW_LESSONS.find((l) => l.slug === slug) || AI_LESSONS.find((l) => l.slug === slug);
+  if (lesson) {
+    return pageMetadata({
+      title: `${lesson.title} flash cards`,
+      description: lesson.summary,
+      path: `/flashcards/${slug}`,
+    });
+  }
+  return pageMetadata({
+    title: "Flash cards",
+    description: "Practice deck",
+    path: `/flashcards/${slug}`,
+    noIndex: true,
+  });
+}
+
+export default async function FlashcardDeckPage({ params }: { params: Promise<{ slug: string }> }) {
+  const { slug } = await params;
+  await requirePageRolesOrGuest("/flashcards", [...CANDIDATE_ROLES, "SUPER_ADMIN", "HIRING_MANAGER", "TECHNICAL_REVIEWER"]);
+
+  const challenge = await prisma.challenge.findFirst({
+    where: { slug, isPublished: true },
+    select: {
+      slug: true,
+      title: true,
+      summary: true,
+      description: true,
+      tags: true,
+      companies: true,
+      publicRequirements: true,
+      hiddenRequirements: true,
+      hints: true,
+      adaptiveTrack: true,
+    },
+  });
+
+  if (challenge) {
+    const cards = buildChallengeFlashCards(challenge);
+    return (
+      <FlashcardsClient
+        slug={challenge.slug}
+        title={challenge.title}
+        summary={challenge.summary}
+        cards={cards}
+        challengeHref={`/challenges/${challenge.slug}`}
+      />
+    );
+  }
+
+  const lesson =
+    INTERVIEW_LESSONS.find((l) => l.slug === slug) || AI_LESSONS.find((l) => l.slug === slug);
+  if (!lesson) notFound();
+
+  return (
+    <FlashcardsClient
+      slug={lesson.slug}
+      title={lesson.title}
+      summary={lesson.summary}
+      cards={buildLessonFlashCards(lesson)}
+      challengeHref={lesson.practiceSlug ? `/challenges/${lesson.practiceSlug}` : "/learn"}
+    />
+  );
+}
