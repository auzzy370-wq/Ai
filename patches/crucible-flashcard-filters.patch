+
+type DiffBand = "all" | "easy" | "medium" | "hard";
+type SortKey = "popular" | "title" | "difficulty-asc" | "difficulty-desc" | "cards";
+
 function storageKey(slug: string) {
   return `crucible_flash_${slug}`;
 }
 
+function diffBand(d: number): Exclude<DiffBand, "all"> {
+  if (d <= 3) return "easy";
+  if (d <= 6) return "medium";
+  return "hard";
+}
+
+function diffLabel(d: number) {
+  const band = diffBand(d);
+  return band === "easy" ? "Easy" : band === "medium" ? "Medium" : "Hard";
+}
+
+function domainLabel(type: string) {
+  if (type === "CODING_PROBLEM") return "Coding";
+  if (type.includes("SECURITY") || type === "APPSEC" || type === "SOC_IR" || type === "CRYPTOGRAPHY" || type === "ZERO_TRUST" || type === "THREAT_MODELING" || type === "DETECTION_ENGINEERING" || type === "IDENTITY_ACCESS" || type === "VULN_TRIAGE" || type === "SECURE_CODE_REVIEW" || type === "CLOUD_SECURITY") {
+    return "Security";
+  }
+  if (type === "FRONTEND") return "Frontend";
+  if (type === "BACKEND" || type === "DATABASE" || type === "PERFORMANCE") return "Backend";
+  if (type.includes("DISTRIBUTED") || type === "INFRASTRUCTURE" || type === "REALTIME_COMMS") return "Systems";
+  if (type.includes("AI")) return "AI";
+  return "Mission";
+}
+
+function Chip(props: {
+  active: boolean;
+  onClick: () => void;
+  children: ReactNode;
+  title?: string;
+}) {
